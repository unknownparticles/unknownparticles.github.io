---
const capabilities = [
  { code: '01', title: '图形与图像', detail: 'OpenGL、OpenCV、Canvas、JPEG 元数据与图像质量分析。' },
  { code: '02', title: '跨端产品', detail: 'Flutter、Dart 和 iOS-first 的交互原型与工具。' },
  { code: '03', title: '前端体验', detail: 'TypeScript、原生 Web、动画、手势和离线应用。' },
  { code: '04', title: '工程自动化', detail: 'GitHub Actions、构建发布、脚本与 AI 工具链。' },
];
---

<section class="capability-section" aria-labelledby="capability-title">
  <div class="shell capability-layout">
    <div class="capability-intro">
      <p class="showcase-kicker">Capabilities</p>
      <h2 id="capability-title">从底层图像到可用产品</h2>
      <p>不只做页面。会分析格式、写渲染代码、做跨端界面，也会把构建和发布自动化。</p>
    </div>
    <ol class="capability-list">
      {capabilities.map((item) => (
        <li>
          <span class="capability-code">{item.code}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

---
import { zh } from '../i18n/zh';
import { en } from '../i18n/en';

const capabilities = [
  { code: '01', key: 'cap1', title: { zh: '图形与图像', en: 'Graphics & imaging' }, detail: { zh: zh.about.practice1, en: en.about.practice1 } },
  { code: '02', key: 'cap2', title: { zh: '跨端产品', en: 'Cross-platform products' }, detail: { zh: zh.about.practice2, en: en.about.practice2 } },
  { code: '03', key: 'cap3', title: { zh: '前端体验', en: 'Web experience' }, detail: { zh: zh.about.practice3, en: en.about.practice3 } },
  { code: '04', key: 'cap4', title: { zh: '工程自动化', en: 'Engineering automation' }, detail: { zh: zh.about.practice4, en: en.about.practice4 } },
];
---

<section class="capability-section" aria-labelledby="capability-title">
  <div class="shell capability-layout">
    <div class="capability-intro">
      <p class="showcase-kicker">Capabilities</p>
      <h2 id="capability-title" data-i18n="home.capabilityTitle">{zh.home.capabilityTitle}</h2>
      <p data-i18n="home.capabilityLede">{zh.home.capabilityLede}</p>
    </div>
    <ol class="capability-list">
      {capabilities.map((item) => (
        <li>
          <span class="capability-code">{item.code}</span>
          <div>
            <h3 data-i18n={`cap.${item.key}`} data-zh={item.title.zh} data-en={item.title.en}>{item.title.zh}</h3>
            <p data-i18n={`cap.${item.key}Detail`} data-zh={item.detail.zh} data-en={item.detail.en}>{item.detail.zh}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

---
import type { Post } from '../lib/posts';
import { formatDate, getExcerpt, getPostUrl } from '../lib/posts';

interface Props {
  posts: Post[];
  offset?: number;
}

const { posts, offset = 0 } = Astro.props;
---

<ol class="post-list">
  {posts.map((post, index) => (
    <li class:list={['post-list__item', index === 0 && 'post-list__item--featured']} data-reveal>
      <article class="post-card">
        <a class="post-card__cover" href={getPostUrl(post)} tabindex="-1" aria-hidden="true">
          <img
            src={`/${post.data['header-img']}`}
            alt=""
            width="848"
            height="522"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </a>
        <div class="post-card__body">
          <div class="post-card__meta">
            <span class="post-number">{String(offset + index + 1).padStart(2, '0')}</span>
            <time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </div>
          <h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>
          {post.data.subtitle && <p class="post-card__subtitle">{post.data.subtitle}</p>}
          <p class="post-card__excerpt">{getExcerpt(post.body ?? '', index === 0 ? 180 : 110)}</p>
          {post.data.tags.length > 0 && (
            <div class="post-card__tags" aria-label="文章标签">
              {post.data.tags.slice(0, 3).map((tag) => <a class="tag" href={`/tags/#${tag}`}>{tag}</a>)}
            </div>
          )}
        </div>
      </article>
    </li>
  ))}
</ol>

---
import { SITE } from '../config';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (path: string) => path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-brand" href="/" aria-label={`${SITE.title}首页`}>
      <span class="site-brand__mark" aria-hidden="true">A/</span>
      <span class="site-brand__name">{SITE.brand}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="打开导航">
      <span class="nav-toggle__icon" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-navigation" aria-label="主导航" data-open="false">
      <ul>
        <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>首页</a></li>
        <li><a href="/projects/" aria-current={isCurrent('/projects/') ? 'page' : undefined}>作品</a></li>
        <li><a href="/tags/" aria-current={isCurrent('/tags/') ? 'page' : undefined}>标签</a></li>
        <li><a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>关于</a></li>
      </ul>
    </nav>
  </div>
</header>

---
import { portfolio } from '../data/portfolio';
import { zh } from '../i18n/zh';
import { en } from '../i18n/en';
import { technicalProjects } from '../data/showcase';

const titles = {
  workTitle: { zh: zh.home.workTitle, en: en.home.workTitle },
  workMore: { zh: zh.home.workMore, en: en.home.workMore },
};
---

<section class="work-showcase" aria-labelledby="work-showcase-title">
  <div class="shell showcase-heading">
    <div>
      <p class="showcase-kicker">Selected work</p>
      <h2 id="work-showcase-title" data-i18n="home.workTitle">{zh.home.workTitle}</h2>
    </div>
    <p><span class="num">{portfolio.pagesRepositoryCount}</span> <span data-i18n="home.pagesNote">{zh.home.pagesNote}</span></p>
  </div>

  <div class="shell showcase-grid">
    {technicalProjects.filter((project) => project.preview).map((project) => (
      <article class="showcase-card">
        <a class="showcase-preview" href={project.demoUrl} target="_blank" rel="noopener" aria-label={project.title}>
          <img src={project.preview} alt={`${project.title}`} width="720" height="480" loading="lazy" decoding="async" />
          <span class="showcase-open" aria-hidden="true">Open</span>
        </a>
        <div class="showcase-copy">
          <div>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
          </div>
          <nav aria-label={project.title}>
            <a href={project.demoUrl} target="_blank" rel="noopener" data-i18n="work.demo">{zh.work.demo}</a>
            <a href={project.repoUrl} target="_blank" rel="noopener" data-i18n="work.source">{zh.work.source}</a>
          </nav>
        </div>
      </article>
    ))}
  </div>

  <div class="shell showcase-more">
    <a href="/projects/" data-i18n="home.workMore">{zh.home.workMore}</a>
  </div>
</section>

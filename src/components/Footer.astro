---
import { SITE } from '../config';
import { portfolio } from '../data/portfolio';
import { zh } from '../i18n/zh';
---

<footer class="site-footer">
  <div class="shell site-footer__top">
    <div>
      <span class="footer-label" data-i18n="footer.label" data-zh="Keep building" data-en="Keep building">Keep building</span>
      <h2 data-i18n="footer.lede">{zh.footer.lede}</h2>
    </div>
    <ul class="footer-links" aria-label="External links">
      <li><a href={`https://github.com/${SITE.github}`} target="_blank" rel="noopener">GitHub</a></li>
      <li><a href="https://blog.csdn.net/particles" target="_blank" rel="noopener">CSDN</a></li>
      <li><a href={`mailto:${SITE.email}`} data-i18n="footer.mail" data-zh="邮件" data-en="Email">邮件</a></li>
      <li><a href="/feed.xml">RSS</a></li>
    </ul>
  </div>
  <div class="shell site-footer__bottom">
    <p>© {new Date().getFullYear()} Alun · <span data-i18n="footer.rights">{zh.footer.rights}</span></p>
    <p data-i18n="footer.builtWith">{zh.footer.builtWith}</p>
    <p><span data-i18n="footer.verified">{zh.footer.verified}</span> {portfolio.verifiedAt}</p>
  </div>
</footer>

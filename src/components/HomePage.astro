---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolio } from '../data/portfolio';
import type { Post } from '../lib/posts';
import { formatDate, getPostUrl } from '../lib/posts';

interface Props {
  posts: Post[];
  allPosts: Post[];
  pageNumber: number;
  totalPages: number;
}

const { posts, allPosts, pageNumber, totalPages } = Astro.props;
const previousUrl = pageNumber === 2 ? '/' : `/page${pageNumber - 1}/`;
const nextUrl = `/page${pageNumber + 1}/`;
const profileProjects = portfolio.featuredProjects.slice(0, 3);
const projectSummaries: Record<string, string> = {
  'Electronic-Woodfish': '在线电子木鱼，通过交互累计功德、幸运值与幸福值。',
  photo: '在浏览器中完成静态图片处理的轻量工具。',
  'jpeg-info': '使用 C++ 解析并展示 JPEG 元数据。',
};
---

<BaseLayout>
  <main class="profile-page" id="main-content">
    <section class="profile-intro shell" aria-labelledby="profile-name">
      <img
        class="profile-avatar"
        src="/img/alun-avatar.webp"
        alt="Alun 的头像"
        width="180"
        height="180"
        fetchpriority="high"
      />
      <div class="profile-copy">
        <h1 id="profile-name">Alun</h1>
        <p class="profile-role">开发者、导演、摄影师。</p>
        <p class="profile-summary">我把图像处理、Flutter、前端交互和自动化里遇到的问题做成工具，也把过程写成文章。</p>
        <nav class="profile-links" aria-label="个人链接">
          <a href={portfolio.githubUrl} target="_blank" rel="noopener">GitHub</a>
          <a href="https://blog.csdn.net/particles" target="_blank" rel="noopener">CSDN</a>
          <a href="mailto:unknownparticles@gmail.com">Email</a>
          <a href="/feed.xml">RSS</a>
        </nav>
      </div>
      <dl class="profile-stats" aria-label="公开数据">
        <div><dt>文章</dt><dd>{allPosts.length}</dd></div>
        <div><dt>仓库</dt><dd>{portfolio.ownRepositoryCount}</dd></div>
        <div><dt>在线</dt><dd>{portfolio.pagesRepositoryCount}</dd></div>
      </dl>
    </section>

    {pageNumber === 1 && (
      <section class="shell profile-section" aria-labelledby="featured-projects">
        <div class="section-heading">
          <h2 id="featured-projects">正在做的项目</h2>
          <a href="/projects/">查看全部</a>
        </div>
        <div class="home-projects">
          {profileProjects.map((project) => (
            <article class="home-project">
              <div>
                <h3><a href={project.repoUrl} target="_blank" rel="noopener">{project.name}</a></h3>
                <p>{projectSummaries[project.name] ?? project.summary}</p>
              </div>
              <div class="home-project__meta">
                <span>{project.language}</span>
                <span class="num">★ {project.stars}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="shell profile-section" aria-labelledby="latest-posts">
      <div class="section-heading">
        <h2 id="latest-posts">{pageNumber === 1 ? '最近文章' : `文章 · 第 ${pageNumber} 页`}</h2>
        <a href="/tags/">按标签浏览</a>
      </div>

      <ol class="home-posts">
        {posts.map((post) => (
          <li>
            <a class="home-post" href={getPostUrl(post)}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <div>
                <h3>{post.data.title}</h3>
                {post.data.subtitle && <p>{post.data.subtitle}</p>}
              </div>
              <span class="home-post__arrow" aria-hidden="true">›</span>
            </a>
          </li>
        ))}
      </ol>

      {totalPages > 1 && (
        <nav class="pagination" aria-label="文章分页">
          {pageNumber > 1 && <a href={previousUrl}>较新的文章</a>}
          <span>第 {pageNumber} / {totalPages} 页</span>
          {pageNumber < totalPages && <a href={nextUrl}>更早的文章</a>}
        </nav>
      )}
    </section>
  </main>
</BaseLayout>

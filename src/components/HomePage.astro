---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolio } from '../data/portfolio';
import type { Post } from '../lib/posts';
import { formatDate, getExcerpt, getPostUrl } from '../lib/posts';

interface Props {
  posts: Post[];
  allPosts: Post[];
  pageNumber: number;
  totalPages: number;
}

const { posts, allPosts, pageNumber, totalPages } = Astro.props;
const featured = posts[0];
const rest = posts.slice(1);
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))]
  .map((name) => ({ name, count: allPosts.filter((post) => post.data.tags.includes(name)).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'))
  .slice(0, 8);
const previousUrl = pageNumber === 2 ? '/' : `/page${pageNumber - 1}/`;
const nextUrl = `/page${pageNumber + 1}/`;
---

<BaseLayout>
  <header class="home-hero">
    <div class="shell home-hero__inner">
      <div class="home-hero__copy">
        <p class="hero-eyebrow">阿伦的开发笔记，自 2024 年起持续更新</p>
        <h1>把问题拆开，做成能跑的代码</h1>
        <p class="home-hero__lede">记录 Flutter、图形与图像处理、前端交互和工程自动化的实践过程。这里保留真实的尝试、踩过的坑和最后能复用的结果。</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#latest-posts">阅读文章</a>
          <a class="hero-text-link" href="/projects/">查看开源作品</a>
        </div>
      </div>
      <dl class="hero-figures" aria-label="站点与仓库数据">
        <div><dt>技术文章</dt><dd>{allPosts.length}</dd></div>
        <div><dt>自有仓库</dt><dd>{portfolio.ownRepositoryCount}</dd></div>
        <div><dt>已上线页面</dt><dd>{portfolio.pagesRepositoryCount}</dd></div>
      </dl>
    </div>

    <nav class="shell hero-topics" aria-label="常写主题">
      <h2 class="topic-strip__title">常写主题</h2>
      <div class="topic-strip__links">
        {tags.map((tag) => <a href={`/tags/#${tag.name}`}>{tag.name}<sup>{tag.count}</sup></a>)}
      </div>
    </nav>
  </header>

  <section class="manifesto" aria-label="工作方式" data-reveal>
    <div class="shell">
      <h2 class="manifesto-title">
        <span class="manifesto-word">先读懂问题，</span>
        <span class="manifesto-word">再写最小的代码，</span>
        <span class="manifesto-word">把过程写成</span>
        <span class="manifesto-word">下次能复用的经验。</span>
      </h2>
    </div>
  </section>

  <main class="site-main" id="main-content">
    <div class="shell home-content">
      <section aria-labelledby="latest-posts">
        <div class="feed-header" data-reveal>
          <h2 id="latest-posts">{pageNumber === 1 ? '最近写下的' : '继续往前翻'}</h2>
          <p>{allPosts.length} 篇 · 第 {pageNumber} 页</p>
        </div>

        {featured && (
          <article class="feature" data-reveal>
            <figure class="feature__figure">
              <img
                src={`/${featured.data['header-img']}`}
                alt={`《${featured.data.title}》的题图`}
                width="520"
                height="390"
                fetchpriority="high"
                decoding="async"
              />
              <figcaption>{featured.data.title}的题图</figcaption>
            </figure>
            <div class="feature__body">
              <p class="feature__meta">
                <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
                <span>最新一篇</span>
              </p>
              <h3><a href={getPostUrl(featured)}>{featured.data.title}</a></h3>
              {featured.data.subtitle && <p class="feature__subtitle">{featured.data.subtitle}</p>}
              <p class="feature__excerpt">{getExcerpt(featured.body ?? '', 180)}</p>
            </div>
          </article>
        )}

        <ol class="post-list">
          {rest.map((post) => (
            <li class="post-list__item" data-reveal>
              <article class="post-row">
                <time class="post-row__date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <div class="post-row__main">
                  <h3 class="post-row__title"><a href={getPostUrl(post)}>{post.data.title}</a></h3>
                  {post.data.subtitle && <p class="post-row__subtitle">{post.data.subtitle}</p>}
                </div>
                <div class="post-row__side">{post.data.tags.slice(0, 2).join(' / ') || '笔记'}</div>
              </article>
            </li>
          ))}
        </ol>

        {totalPages > 1 && (
          <nav class="post-navigation" aria-label="文章分页" data-reveal>
            {pageNumber > 1 ? (
              <a href={previousUrl}><span>上一页</span><strong>回到更新的文章</strong></a>
            ) : <span aria-hidden="true"></span>}
            {pageNumber < totalPages && (
              <a class="post-navigation__next" href={nextUrl}><span>下一页</span><strong>继续看更早的文章</strong></a>
            )}
          </nav>
        )}
      </section>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkShowcase from './WorkShowcase.astro';
import SelectedWriting from './SelectedWriting.astro';
import Capabilities from './Capabilities.astro';
import { portfolio } from '../data/portfolio';
import { zh } from '../i18n/zh';
import { en } from '../i18n/en';
import type { Post } from '../lib/posts';
import { formatDate, getPostUrl } from '../lib/posts';

interface Props {
  posts: Post[];
  allPosts: Post[];
  pageNumber: number;
  totalPages: number;
}

const { posts, allPosts, pageNumber, totalPages } = Astro.props;
const previousUrl = pageNumber === 2 ? '/' : `/page${pageNumber - 1}/`;
const nextUrl = `/page${pageNumber + 1}/`;


---

<BaseLayout i18nTitle={{ zh: zh.meta.title, en: en.meta.title }} i18nDescription={{ zh: zh.meta.description, en: en.meta.description }}>
  <main id="main-content">
    {pageNumber === 1 && (
      <>
        <section class="lab-hero" aria-labelledby="lab-title">
          <div class="shape-stage" id="shape-stage" aria-hidden="true"></div>
          <div class="shell lab-hero__inner">
            <div class="lab-copy">
              <p class="lab-status"><span></span><span data-i18n="home.status">{zh.home.status}</span></p>
              <h1 id="lab-title">
                <span data-i18n="home.titleLead">{zh.home.titleLead}</span><br />
                <em data-i18n="home.titleEm">{zh.home.titleEm}</em>
                <span data-i18n="home.titleTail">{zh.home.titleTail}</span>
              </h1>
              <p data-i18n="home.lede">{zh.home.lede}</p>
              <nav class="lab-actions" aria-label="Primary actions">
                <a class="lab-button" href="#selected-work" data-i18n="home.ctaWork">{zh.home.ctaWork}</a>
                <a href="https://github.com/unknownparticles" target="_blank" rel="noopener" data-i18n="home.ctaGithub">{zh.home.ctaGithub}</a>
                <a href="mailto:unknownparticles@gmail.com" data-i18n="home.ctaMail">{zh.home.ctaMail}</a>
              </nav>
            </div>
            <div class="lab-side">
              <dl>
                <div><dt data-i18n="home.repos">{zh.home.repos}</dt><dd>{portfolio.ownRepositoryCount}</dd></div>
                <div><dt data-i18n="home.live">{zh.home.live}</dt><dd>{portfolio.pagesRepositoryCount}</dd></div>
                <div><dt data-i18n="home.writing">{zh.home.writing}</dt><dd>{allPosts.length}</dd></div>
              </dl>
            </div>
          </div>
          <div class="lab-marquee" aria-hidden="true">
            <div>
              <span>Flutter</span><i>◆</i><span>OpenGL</span><i>◆</i><span>TypeScript</span><i>◆</i><span>Image Processing</span><i>◆</i><span>Automation</span><i>◆</i><span>Flutter</span><i>◆</i><span>OpenGL</span><i>◆</i><span>TypeScript</span>
            </div>
          </div>
        </section>

        <div id="selected-work"><WorkShowcase /></div>
        <SelectedWriting posts={allPosts} />
        <Capabilities />
      </>
    )}

    <section class="writing-section" aria-labelledby="latest-posts">
      <div class="shell">
        <div class="writing-heading">
          <div>
            <p class="showcase-kicker" data-i18n="home.writingTitle" data-zh="写作" data-en="Writing">写作</p>
            <h2 id="latest-posts" data-i18n="home.writingTitle">{zh.home.writingTitle}</h2>
          </div>
          <a href="/tags/" data-i18n="home.writingMore">{zh.home.writingMore}</a>
        </div>

        <ol class="home-posts">
          {posts.map((post) => (
            <li>
              <a class="home-post" href={getPostUrl(post)}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <div>
                  <h3>{post.data.title}</h3>
                  {post.data.subtitle && <p>{post.data.subtitle}</p>}
                </div>
                <span class="home-post__arrow" aria-hidden="true">›</span>
              </a>
            </li>
          ))}
        </ol>

        {totalPages > 1 && (
          <nav class="pagination" aria-label="Pagination">
            {pageNumber > 1 && <a href={previousUrl} data-i18n="home.newer">{zh.home.newer}</a>}
            <span><span data-i18n="home.page">{zh.home.page}</span> {pageNumber} / {totalPages}</span>
            {pageNumber < totalPages && <a href={nextUrl} data-i18n="home.older">{zh.home.older}</a>}
          </nav>
        )}
      </div>
    </section>

    {pageNumber === 1 && (
      <section class="contact-band" aria-labelledby="contact-title">
        <div class="shell contact-band__inner">
          <p class="showcase-kicker" data-i18n="home.contactTitle" data-zh="联系我" data-en="Say hello">联系我</p>
          <h2 id="contact-title">
            <span data-i18n="home.contactTitle">{zh.home.contactTitle}</span><br />
            <span data-i18n="home.contactTail">{zh.home.contactTail}</span>
          </h2>
          <a href="mailto:unknownparticles@gmail.com">unknownparticles@gmail.com</a>
        </div>
      </section>
    )}
  </main>

  <script>
    import '../scripts/mount-shapes';
  </script>
</BaseLayout>

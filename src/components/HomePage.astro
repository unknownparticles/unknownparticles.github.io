---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from './PostList.astro';
import { portfolio } from '../data/portfolio';
import type { Post } from '../lib/posts';
import { getTagCounts } from '../lib/posts';

interface Props {
  posts: Post[];
  allPosts: Post[];
  pageNumber: number;
  totalPages: number;
}

const { posts, allPosts, pageNumber, totalPages } = Astro.props;
const tags = getTagCounts(allPosts).slice(0, 8);
const previousUrl = pageNumber === 2 ? '/' : `/page${pageNumber - 1}/`;
const nextUrl = `/page${pageNumber + 1}/`;
---

<BaseLayout>
  <header class="home-hero">
    <div class="shell home-hero__inner">
      <div class="home-hero__copy">
        <h1><span>Alun</span><br />开发笔记</h1>
        <p class="home-hero__lede">关于 Flutter、图形技术、前端交互和工程自动化。记录真实问题，也保留解决问题时走过的路。</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#latest-posts">开始阅读</a>
          <a class="hero-text-link" href="/projects/">浏览开源作品</a>
        </div>
      </div>
      <div class="hero-proof" aria-label="站点数据">
        <span><strong>{allPosts.length}</strong> 篇技术笔记</span>
        <span><strong>{portfolio.publicRepositoryCount}</strong> 个公开仓库</span>
        <span><strong>8</strong> 个在线作品</span>
      </div>
    </div>
  </header>

  <section class="manifesto" aria-labelledby="manifesto-title" data-reveal>
    <div class="shell">
      <h2 class="manifesto-title" id="manifesto-title">
        <span class="manifesto-word">把复杂问题拆开，</span>
        <span class="manifesto-word">做成可以运行的代码，</span>
        <span class="manifesto-word">再把过程写成</span>
        <span class="manifesto-word">可以复用的经验。</span>
      </h2>
    </div>
  </section>

  <main class="site-main" id="main-content">
    <div class="shell home-content">
      <nav class="topic-strip" aria-label="常写主题" data-reveal>
        <h2 class="topic-strip__title">常写主题</h2>
        <div class="topic-strip__links">
          {tags.map((tag) => <a href={`/tags/#${tag.name}`}>{tag.name}<sup>{tag.count}</sup></a>)}
        </div>
      </nav>

      <section aria-labelledby="latest-posts">
        <div class="feed-header" data-reveal>
          <div>
            <h2 id="latest-posts">{pageNumber === 1 ? '最近写下的' : '继续往前翻'}</h2>
          </div>
          <p>{allPosts.length} 篇公开笔记，持续更新</p>
        </div>
        <PostList posts={posts} offset={(pageNumber - 1) * 10} />
        {totalPages > 1 && (
          <nav class="post-navigation" aria-label="文章分页" data-reveal>
            {pageNumber > 1 ? (
              <a href={previousUrl}><span>上一页</span><strong>回到更新的文章</strong></a>
            ) : <span aria-hidden="true"></span>}
            {pageNumber < totalPages && (
              <a class="post-navigation__next" href={nextUrl}><span>下一页</span><strong>继续看更早的文章</strong></a>
            )}
          </nav>
        )}
      </section>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkShowcase from './WorkShowcase.astro';
import Capabilities from './Capabilities.astro';
import { portfolio } from '../data/portfolio';
import type { Post } from '../lib/posts';
import { formatDate, getPostUrl } from '../lib/posts';

interface Props {
  posts: Post[];
  allPosts: Post[];
  pageNumber: number;
  totalPages: number;
}

const { posts, allPosts, pageNumber, totalPages } = Astro.props;
const previousUrl = pageNumber === 2 ? '/' : `/page${pageNumber - 1}/`;
const nextUrl = `/page${pageNumber + 1}/`;
---

<BaseLayout>
  <main id="main-content">
    {pageNumber === 1 && (
      <>
        <section class="lab-hero" aria-labelledby="lab-title">
          <div class="lab-scene" id="lab-scene" aria-hidden="true"></div>
          <div class="shell lab-hero__inner">
            <div class="lab-copy">
              <p class="lab-status"><span></span> Available for interesting work</p>
              <h1 id="lab-title">Alun<br /><em>builds</em> things.</h1>
              <p>开发者、导演、摄影师。把图像、交互和自动化里复杂的问题，做成能直接使用的产品。</p>
              <nav class="lab-actions" aria-label="首页行动">
                <a class="lab-button" href="#selected-work">查看作品</a>
                <a href="https://github.com/unknownparticles" target="_blank" rel="noopener">GitHub</a>
                <a href="mailto:unknownparticles@gmail.com">联系我</a>
              </nav>
            </div>
            <div class="lab-side">
              <span class="lab-coordinate">22.5431° N<br />114.0579° E</span>
              <dl>
                <div><dt>Repos</dt><dd>{portfolio.ownRepositoryCount}</dd></div>
                <div><dt>Live</dt><dd>{portfolio.pagesRepositoryCount}</dd></div>
                <div><dt>Writing</dt><dd>{allPosts.length}</dd></div>
              </dl>
            </div>
          </div>
          <div class="lab-marquee" aria-hidden="true">
            <div>
              <span>Flutter</span><i>◆</i><span>OpenGL</span><i>◆</i><span>TypeScript</span><i>◆</i><span>Image Processing</span><i>◆</i><span>Automation</span><i>◆</i><span>Flutter</span><i>◆</i><span>OpenGL</span><i>◆</i><span>TypeScript</span>
            </div>
          </div>
        </section>

        <div id="selected-work"><WorkShowcase /></div>
        <Capabilities />
      </>
    )}

    <section class="writing-section" aria-labelledby="latest-posts">
      <div class="shell">
        <div class="writing-heading">
          <div>
            <p class="showcase-kicker">Writing</p>
            <h2 id="latest-posts">{pageNumber === 1 ? '最近写下的' : `文章 · 第 ${pageNumber} 页`}</h2>
          </div>
          <a href="/tags/">按标签浏览</a>
        </div>

        <ol class="home-posts">
          {posts.map((post) => (
            <li>
              <a class="home-post" href={getPostUrl(post)}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <div>
                  <h3>{post.data.title}</h3>
                  {post.data.subtitle && <p>{post.data.subtitle}</p>}
                </div>
                <span class="home-post__arrow" aria-hidden="true">›</span>
              </a>
            </li>
          ))}
        </ol>

        {totalPages > 1 && (
          <nav class="pagination" aria-label="文章分页">
            {pageNumber > 1 && <a href={previousUrl}>较新的文章</a>}
            <span>第 {pageNumber} / {totalPages} 页</span>
            {pageNumber < totalPages && <a href={nextUrl}>更早的文章</a>}
          </nav>
        )}
      </div>
    </section>

    {pageNumber === 1 && (
      <section class="contact-band" aria-labelledby="contact-title">
        <div class="shell contact-band__inner">
          <p class="showcase-kicker">Say hello</p>
          <h2 id="contact-title">有值得做的问题？<br />一起把它做出来。</h2>
          <a href="mailto:unknownparticles@gmail.com">unknownparticles@gmail.com</a>
        </div>
      </section>
    )}
  </main>

  <script>
    const loadScene = () => import('../scripts/lab-scene').then(({ mountLabScene }) => mountLabScene());
    const idle = window.requestIdleCallback;
    if (typeof idle === 'function') {
      idle(loadScene, { timeout: 1200 });
    } else {
      globalThis.setTimeout(loadScene, 500);
    }
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { zh } from '../i18n/zh';
import { en } from '../i18n/en';
import { getAllPosts, getPostUrl, getTagCounts, formatDate } from '../lib/posts';
import '../scripts/controls';

const posts = await getAllPosts();
const tags = getTagCounts(posts);
---

<BaseLayout
  title="文章索引"
  i18nTitle={{ zh: zh.archive.title, en: en.archive.title }}
  i18nDescription={{ zh: `${posts.length} ${zh.archive.lede}`, en: `${posts.length} ${en.archive.lede}` }}
>
  <main class="archive-page" id="main-content">
    <header class="shell archive-page__hero">
      <p class="showcase-kicker">Writing archive</p>
      <h1 data-i18n="archive.title">{zh.archive.title}</h1>
      <p>
        <span class="num">{posts.length}</span> <span data-i18n="archive.lede">{zh.archive.lede}</span>
      </p>
    </header>

    <section class="shell archive-page__body">
      <nav class="archive-filters" aria-label="Topics">
        <button class="is-active" type="button" data-filter="all">
          <span data-i18n="archive.all">{zh.archive.all}</span> <span>{posts.length}</span>
        </button>
        {tags.map((tag) => (
          <button type="button" data-filter={tag.name}>{tag.name} <span>{tag.count}</span></button>
        ))}
      </nav>

      <div>
        <p class="archive-result" role="status">
          <span data-i18n="archive.result">{zh.archive.result}</span> {posts.length} <span data-i18n="archive.posts">{zh.archive.posts}</span>
        </p>
        <ol class="archive-list">
          {posts.map((post) => (
            <li data-tags={post.data.tags.join('|')}>
              <a href={getPostUrl(post)}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <div>
                  <h2>{post.data.title}</h2>
                  {post.data.subtitle && <p>{post.data.subtitle}</p>}
                </div>
                <span>{post.data.tags.slice(0, 2).join(' / ')}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { currentLang } from '../scripts/settings';

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const rows = [...document.querySelectorAll<HTMLLIElement>('.archive-list li')];
  const result = document.querySelector<HTMLElement>('.archive-result');
  const allLabel = document.querySelector<HTMLElement>('[data-filter="all"] [data-i18n="archive.all"]')?.textContent ?? 'All';
  const postsLabel = document.querySelector<HTMLElement>('.archive-result [data-i18n="archive.posts"]')?.textContent ?? 'posts';
  const join = currentLang() === 'en' ? ': ' : '：';

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      let count = 0;
      buttons.forEach((item) => item.classList.toggle('is-active', item === button));
      rows.forEach((row) => {
        const visible = filter === 'all' || (row.dataset.tags ?? '').split('|').includes(filter);
        row.hidden = !visible;
        if (visible) count += 1;
      });
      if (result) {
        result.textContent = filter === 'all' ? `${allLabel} ${count} ${postsLabel}` : `${filter}${join}${count} ${postsLabel}`;
      }
      history.replaceState(null, '', filter === 'all' ? '/tags/' : `/tags/#${encodeURIComponent(filter)}`);
    });
  });

  const initial = decodeURIComponent(location.hash.slice(1));
  if (initial) {
    document.querySelector<HTMLButtonElement>(`[data-filter="${CSS.escape(initial)}"]`)?.click();
  }
</script>

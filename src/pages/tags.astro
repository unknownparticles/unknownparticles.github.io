---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts, getPostUrl, getTagCounts, formatDate } from '../lib/posts';

const posts = await getAllPosts();
const tags = getTagCounts(posts);
---

<BaseLayout title="文章索引" description="按技术主题浏览全部文章。">
  <main class="archive-page" id="main-content">
    <header class="shell archive-page__hero">
      <p class="showcase-kicker">Writing archive</p>
      <h1>文章索引</h1>
      <p>{posts.length} 篇文章，{tags.length} 个主题。选择主题筛选，也可以按时间从新到旧浏览。</p>
    </header>

    <section class="shell archive-page__body">
      <nav class="archive-filters" aria-label="文章主题">
        <button class="is-active" type="button" data-filter="all">全部 <span>{posts.length}</span></button>
        {tags.map((tag) => (
          <button type="button" data-filter={tag.name}>{tag.name} <span>{tag.count}</span></button>
        ))}
      </nav>

      <div>
        <p class="archive-result" role="status">显示全部 {posts.length} 篇</p>
        <ol class="archive-list">
          {posts.map((post) => (
            <li data-tags={post.data.tags.join('|')}>
              <a href={getPostUrl(post)}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <div>
                  <h2>{post.data.title}</h2>
                  {post.data.subtitle && <p>{post.data.subtitle}</p>}
                </div>
                <span>{post.data.tags.slice(0, 2).join(' / ')}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const rows = document.querySelectorAll<HTMLElement>('.archive-list li');
    const result = document.querySelector<HTMLElement>('.archive-result');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        let count = 0;
        buttons.forEach((item) => item.classList.toggle('is-active', item === button));
        rows.forEach((row) => {
          const visible = filter === 'all' || (row.dataset.tags ?? '').split('|').includes(filter);
          row.hidden = !visible;
          if (visible) count += 1;
        });
        if (result) result.textContent = filter === 'all' ? `显示全部 ${count} 篇` : `${filter}：${count} 篇`;
        history.replaceState(null, '', filter === 'all' ? '/tags/' : `/tags/#${encodeURIComponent(filter)}`);
      });
    });

    const initial = decodeURIComponent(location.hash.slice(1));
    if (initial) document.querySelector<HTMLButtonElement>(`[data-filter="${CSS.escape(initial)}"]`)?.click();
  </script>
</BaseLayout>

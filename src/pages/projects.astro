---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolio } from '../data/portfolio';
import { zh } from '../i18n/zh';
import { en } from '../i18n/en';
import { technicalProjects, demoGroups } from '../data/showcase';
---

<BaseLayout
  title="作品"
  i18nTitle={{ zh: zh.nav.work, en: en.nav.work }}
  i18nDescription={{ zh: zh.work.intro, en: en.work.intro }}
>
  <main id="main-content" class="work-page">
    <header class="work-page__hero shell">
      <p class="work-page__index" data-i18n="work.index">{zh.work.index} / {portfolio.verifiedAt}</p>
      <h1><span data-i18n="work.title">{zh.work.title}</span><br /><em data-i18n="work.titleEm">{zh.work.titleEm}</em></h1>
      <div class="work-page__intro">
        <p data-i18n="work.intro">{zh.work.intro}</p>
        <a href={portfolio.githubUrl} target="_blank" rel="noopener" data-i18n="work.allRepos">{zh.work.allRepos}</a>
      </div>
    </header>

    <section class="shell engineering-work" aria-labelledby="engineering-title">
      <div class="engineering-heading">
        <div>
          <p class="showcase-kicker">Technical work</p>
          <h2 id="engineering-title" data-i18n="work.technical">{zh.work.technical}</h2>
        </div>
      </div>
      <div class="engineering-grid">
        {technicalProjects.map((project, index) => (
          <article class:list={['engineering-card', `engineering-card--${project.accent}`, index === 0 && 'engineering-card--lead']}>
            {project.preview ? (
              <a class="engineering-card__preview" href={project.demoUrl} target="_blank" rel="noopener">
                <img src={project.preview} alt={project.title} width="720" height="480" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              </a>
            ) : (
              <div class="engineering-card__signal" aria-hidden="true">
                <span>{project.language}</span>
                <div>{(project.signal ?? project.evidence).map((item, signalIndex) => (
                  <code data-i18n={`signal.${project.name}.${signalIndex}`} data-zh={item} data-en={project.signal ? item : project.evidenceEn[signalIndex]}>{item}</code>
                ))}</div>
              </div>
            )}
            <div class="engineering-card__body">
              <p class="engineering-card__repo">{project.name}</p>
              <h3 data-i18n={`tech.${project.name}`} data-zh={project.title} data-en={project.titleEn}>{project.title}</h3>
              <p data-i18n={`tech.${project.name}Summary`} data-zh={project.summary} data-en={project.summaryEn}>{project.summary}</p>
              <ul>{project.evidence.map((item, index) => <li data-i18n={`tech.${project.name}.tag.${index}`} data-zh={item} data-en={project.evidenceEn[index]}>{item}</li>)}</ul>
              <nav aria-label={project.title}>
                {project.caseSlug && <a href={`/projects/${project.caseSlug}/`} data-i18n="work.caseStudy">{zh.work.caseStudy}</a>}
                <a href={project.repoUrl} target="_blank" rel="noopener" data-i18n="work.source">{zh.work.source}</a>
                {project.demoUrl && <a href={project.demoUrl} target="_blank" rel="noopener" data-i18n="work.demo">{zh.work.demo}</a>}
              </nav>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="demo-catalog" aria-labelledby="demo-title">
      <div class="shell demo-catalog__heading">
        <div>
          <p class="showcase-kicker">Live index</p>
          <h2 id="demo-title" data-i18n="work.liveTitle">{zh.work.liveTitle}</h2>
        </div>
        <p><span class="num">{portfolio.pagesRepositoryCount}</span> <span data-i18n="work.liveIntro">{zh.work.liveIntro}</span></p>
      </div>

      <div class="shell demo-groups">
        {demoGroups.map((group) => (
          <section class="demo-group" aria-labelledby={`demo-${group.id}`}>
            <header>
              <h3 id={`demo-${group.id}`} data-i18n={`demos.${group.id}`} data-zh={group.title} data-en={group.titleEn}>{group.title}</h3>
              <p data-i18n={`demos.${group.id}Desc`} data-zh={group.description} data-en={group.descriptionEn}>{group.description}</p>
            </header>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.demoUrl} target="_blank" rel="noopener">
                    <span><strong data-i18n={`demo.${group.id}.${item.name}`} data-zh={item.name} data-en={item.nameEn}>{item.name}</strong><small data-i18n={`demoDesc.${group.id}.${item.name}`} data-zh={item.description} data-en={item.descriptionEn}>{item.description}</small></span>
                    <em>{item.language}</em>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section class="shell work-languages" aria-label="Repository languages">
      <h2 data-i18n="work.languages">{zh.work.languages}</h2>
      <div>
        {portfolio.languages.map((item) => (
          <p><span>{item.language}</span><strong class="num">{item.count}</strong></p>
        ))}
      </div>
      <a class="lab-button" href={portfolio.repositoriesUrl} target="_blank" rel="noopener" data-i18n="work.browseAll">{zh.work.browseAll}</a>
    </section>
  </main>
</BaseLayout>

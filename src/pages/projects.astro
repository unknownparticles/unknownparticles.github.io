---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolio } from '../data/portfolio';
import { technicalProjects, demoGroups } from '../data/showcase';
---

<BaseLayout title="作品" description="技术代表作、在线工具与交互实验。">
  <main id="main-content" class="work-page">
    <header class="work-page__hero shell">
      <p class="work-page__index">Engineering / {portfolio.verifiedAt}</p>
      <h1>代码不是展示，<br /><em>结果才是。</em></h1>
      <div class="work-page__intro">
        <p>这里优先展示能体现技术深度的仓库：二进制格式解析、计算机视觉、Flutter、Local-first 产品和 MCP 工具。在线页面则按用途整理在下方。</p>
        <a href={portfolio.githubUrl} target="_blank" rel="noopener">GitHub 上的全部仓库</a>
      </div>
    </header>

    <section class="shell engineering-work" aria-labelledby="engineering-title">
      <div class="engineering-heading">
        <p class="showcase-kicker">Technical work</p>
        <h2 id="engineering-title">技术代表作</h2>
      </div>
      <div class="engineering-grid">
        {technicalProjects.map((project, index) => (
          <article class:list={['engineering-card', `engineering-card--${project.accent}`, index === 0 && 'engineering-card--lead']}>
            {project.preview ? (
              <a class="engineering-card__preview" href={project.demoUrl} target="_blank" rel="noopener">
                <img src={project.preview} alt={`${project.title} 实际页面截图`} width="720" height="480" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              </a>
            ) : (
              <div class="engineering-card__signal" aria-hidden="true">
                <span>{project.language}</span>
                <strong>{String(index + 1).padStart(2, '0')}</strong>
              </div>
            )}
            <div class="engineering-card__body">
              <p class="engineering-card__repo">{project.name}</p>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <ul>{project.evidence.map((item) => <li>{item}</li>)}</ul>
              <nav aria-label={`${project.title} 链接`}>
                <a href={project.repoUrl} target="_blank" rel="noopener">查看源码</a>
                {project.demoUrl && <a href={project.demoUrl} target="_blank" rel="noopener">在线体验</a>}
              </nav>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="demo-catalog" aria-labelledby="demo-title">
      <div class="shell demo-catalog__heading">
        <div>
          <p class="showcase-kicker">Live index</p>
          <h2 id="demo-title">在线工具与实验</h2>
        </div>
        <p>{portfolio.pagesRepositoryCount} 个仓库启用了 GitHub Pages。下面按用途整理最有代表性的入口。</p>
      </div>

      <div class="shell demo-groups">
        {demoGroups.map((group) => (
          <section class="demo-group" aria-labelledby={`demo-${group.id}`}>
            <header>
              <h3 id={`demo-${group.id}`}>{group.title}</h3>
              <p>{group.description}</p>
            </header>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.demoUrl} target="_blank" rel="noopener">
                    <span><strong>{item.name}</strong><small>{item.description}</small></span>
                    <em>{item.language}</em>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section class="shell work-languages" aria-label="仓库语言分布">
      <h2>仓库语言分布</h2>
      <div>
        {portfolio.languages.map((item) => (
          <p><span>{item.language}</span><strong class="num">{item.count}</strong></p>
        ))}
      </div>
      <a class="lab-button" href={portfolio.repositoriesUrl} target="_blank" rel="noopener">浏览全部仓库</a>
    </section>
  </main>
</BaseLayout>

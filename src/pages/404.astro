---
import BaseLayout from '../layouts/BaseLayout.astro';
import { zh } from '../i18n/zh';
import { en } from '../i18n/en';
---

<BaseLayout
  title="404"
  hideFooter={true}
  i18nTitle={{ zh: zh.error.title, en: en.error.title }}
  i18nDescription={{ zh: zh.error.body, en: en.error.body }}
>
  <main class="error-page" id="main-content">
    <div class="shell">
      <p class="error-page__code" data-i18n="error.code">{zh.error.code}</p>
      <h1 data-i18n="error.title">{zh.error.title}</h1>
      <p data-i18n="error.body">{zh.error.body}</p>
      <a class="button button--primary" href="/" data-i18n="error.home">{zh.error.home}</a>
    </div>
  </main>
</BaseLayout>

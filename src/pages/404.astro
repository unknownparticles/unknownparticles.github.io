---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面没有找到" description="这个地址没有对应的页面。" hideFooter={true}>
  <main class="error-page" id="main-content">
    <div class="shell">
      <p class="error-page__code">ERROR / 404</p>
      <h1>页面没有找到</h1>
      <p>这个地址没有对应的页面。你可以回到文章列表，或通过标签继续查找内容。</p>
      <a class="button button--primary" href="/">返回首页</a>
    </div>
  </main>
</BaseLayout>

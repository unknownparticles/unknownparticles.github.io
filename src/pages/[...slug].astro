---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { zh } from '../i18n/zh';
import { formatDate, getAllPosts, getExcerpt, getPostPath, getPostUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

export const getStaticPaths = (async () => {
  const posts = await getAllPosts();
  return posts.map((post, index) => ({
    params: { slug: getPostPath(post) },
    props: {
      post,
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const headerImage = `/${post.data['header-img']}`;
const description = post.data.subtitle ?? getExcerpt(post.body ?? '', 160);
const catalogHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
---

<BaseLayout title={post.data.title} description={description} image={headerImage} type="article">
  <header class="post-hero">
    <div class="post-hero__inner">
      <p class="post-hero__meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span data-i18n="article.by">{zh.article.by}</span>
        <span>{post.data.author}</span>
      </p>
      <h1>{post.data.title}</h1>
      {post.data.subtitle && <p class="post-hero__subtitle">{post.data.subtitle}</p>}
      {post.data.tags.length > 0 && (
        <div class="post-card__tags" aria-label="Tags">
          {post.data.tags.map((tag) => <a class="tag" href={`/tags/#${tag}`}>{tag}</a>)}
        </div>
      )}
    </div>
  </header>

  <figure class="post-cover">
    <img
      src={headerImage}
      alt={post.data.title}
      width="1240"
      height="930"
      loading="lazy"
      decoding="async"
    />
    <figcaption data-i18n="article.cover">{zh.article.cover}</figcaption>
  </figure>

  <main id="main-content">
    <div class:list={['post-layout', !post.data.catalog && 'post-layout--single']}>
      <article class="post-container prose">
        <Content />

        <nav class="post-navigation" aria-label="Posts">
          {newer ? (
            <a href={getPostUrl(newer)}><span data-i18n="article.newer">{zh.article.newer}</span><strong>{newer.data.title}</strong></a>
          ) : <span aria-hidden="true"></span>}
          {older && (
            <a class="post-navigation__next" href={getPostUrl(older)}><span data-i18n="article.older">{zh.article.older}</span><strong>{older.data.title}</strong></a>
          )}
        </nav>

        <section class="comments" aria-labelledby="comments-title">
          <h2 id="comments-title" data-i18n="article.comments">{zh.article.comments}</h2>
          <div id="gitalk-container"></div>
          <script is:inline define:vars={{ gitalkConfig: SITE.gitalk, commentsDown: zh.article.commentsDown }}>
            window.__alunCommentsDown = commentsDown;
            var GitalkClient = Function('return window.Gitalk')();
            var comments = document.getElementById('gitalk-container');
            if (typeof GitalkClient === 'function') {
              var gitalk = new GitalkClient({
                clientID: gitalkConfig.clientID,
                clientSecret: gitalkConfig.clientSecret,
                repo: gitalkConfig.repo,
                owner: gitalkConfig.owner,
                admin: [gitalkConfig.owner],
                distractionFreeMode: true,
                id: window.location.pathname
              });
              gitalk.render('gitalk-container');
            } else if (comments) {
              comments.innerHTML = '<p class="comments-unavailable">' + window.__alunCommentsDown + '</p>';
            }
          </script>
        </section>
      </article>

      {post.data.catalog && catalogHeadings.length > 0 && (
        <aside class="post-catalog" aria-label="文章目录">
          <div class="post-catalog__inner">
            <span class="catalog-title" data-i18n="article.catalog">{zh.article.catalog}</span>
            <ol class="catalog-list">
              {catalogHeadings.map((heading) => (
                <li class={`h${heading.depth}_nav`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </div>
        </aside>
      )}
    </div>
  </main>
</BaseLayout>

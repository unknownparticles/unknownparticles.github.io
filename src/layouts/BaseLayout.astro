---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { zh } from '../i18n/zh';
import { en } from '../i18n/en';
import '../scripts/preferences';
import '../scripts/i18n';
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/portfolio.css';
import '../styles/profile.css';
import '../styles/dopamine.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  hideFooter?: boolean;
  i18nTitle?: { zh: string; en: string };
  i18nDescription?: { zh: string; en: string };
}

const {
  title,
  description,
  image = '/img/apple-touch-icon.png',
  type = 'website',
  hideFooter = false,
  i18nTitle,
  i18nDescription,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const socialImage = new URL(image, Astro.site ?? SITE.url);
const zhTitle = i18nTitle?.zh ?? title ?? zh.meta.title;
const enTitle = i18nTitle?.en ?? title ?? en.meta.title;
const zhDescription = i18nDescription?.zh ?? description ?? zh.meta.description;
const enDescription = i18nDescription?.en ?? description ?? en.meta.description;
---

<!doctype html>
<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" data-i18n-attr="content" data-zh={zhDescription} data-en={enDescription} />
    <meta
      name="keywords"
      content="阿伦, Alun, unknownparticles, 编程, Flutter, OpenGL, OpenCV, 图像处理, 技术博客, developer, portfolio"
    />
    <meta name="theme-color" data-i18n-attr="content" data-zh="#ffffff" data-en="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <title data-i18n="meta.title">{zhTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/pwa/manifest.json" />
    <link rel="icon" href="/img/favicon.ico" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <meta property="og:type" content={type} />
    <meta property="og:title" data-i18n-attr="content" data-zh={zhTitle} data-en={enTitle} />
    <meta property="og:description" data-i18n-attr="content" data-zh={zhDescription} data-en={enDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-i18n="nav.skip">{zh.nav.skip}</a>
    <Header currentPath={Astro.url.pathname} />
    <slot />
    {!hideFooter && <Footer />}
    <script src="/js/site.js" is:inline defer></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function (error) {
            console.warn('Service Worker registration failed:', error);
          });
        });
      }
    </script>
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.dataset.theme = theme;
          }
          var lang = localStorage.getItem('lang');
          if (lang !== 'zh' && lang !== 'en') {
            var list = navigator.languages || [navigator.language || 'zh'];
            lang = list.some(function (item) { return /^en/i.test(item); }) ? 'en' : 'zh';
          }
          document.documentElement.lang = lang === 'en' ? 'en' : 'zh-CN';
          document.documentElement.dataset.lang = lang;
        } catch (error) {
          document.documentElement.dataset.lang = 'zh';
        }
      })();
    </script>
    <script>
      import '../scripts/controls';
      import '../scripts/i18n';
      import { applyLang, currentLang, systemTheme, toggleTheme } from '../scripts/settings';
      window.__alun = { applyLang, currentLang, systemTheme, toggleTheme };
    </script>
  </body>
</html>
